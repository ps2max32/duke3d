+
+// polymost_fs.glsl's fog is GL_EXP2 of density * dist, its dist the window z
+// over the fragment's w: about half of the vertex's w, which is what libgl's
+// fog measures.
+static void ps2_setfog(float density, const coltypef *colour)
+{
+	if (density == ps2_fog) return;
+	if (density <= 0.f) {
+		if (ps2_fog > 0.f) glDisable(GL_FOG);
+	} else {
+		if (ps2_fog <= 0.f) glEnable(GL_FOG);
+		glFogf(GL_FOG_DENSITY, density * 0.5f);
+		glFogfv(GL_FOG_COLOR, &colour->r);
+	}
+	ps2_fog = density;
