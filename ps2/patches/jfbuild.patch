+
+static void ps2_setprojection(const GLfloat *m)
+{
+	if (m != ps2_projection) {
+		ps2_projection = m;
+		glLoadMatrixf(m);
+	}
+}
+
+static void ps2_setalphacut(float cut)
+{
+	if (cut == ps2_alphacut) return;
+	ps2_alphacut = cut;
+	if (cut > 0.f) {
+		glEnable(GL_ALPHA_TEST);
+		glAlphaFunc(GL_GREATER, cut);
+	} else {
+		glDisable(GL_ALPHA_TEST);
+	}
